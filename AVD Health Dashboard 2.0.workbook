    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct SessionHostName;WVDAgentHealthStatus|where TimeGenerated {TimeRange}|where SessionHostName in (C)|extend HealthStatus=tostring(column_ifexists(\"Status\",column_ifexists(\"EndpointState\",\"Unknown\")))|where HealthStatus in~ (\"Unhealthy\",\"Unavailable\") and isnotempty(SessionHostHealthCheckResult)|mv-expand Check=SessionHostHealthCheckResult|where tostring(Check.HealthCheckResult) != \"1\"|summarize arg_max(TimeGenerated,*) by SessionHostName,HealthCheck=tostring(Check.HealthCheckResult),FailureMessage=tostring(Check.AdditionalFailureDetails.Message)|project SessionHostName,HealthStatus,HealthCheck,FailureMessage,AgentVersion,SxSStackVersion,TimeGenerated|order by TimeGenerated desc",
        "size": 0,
        "title": "Unhealthy session hosts and failed health checks",
        "description": "Shows failed checks for hosts whose current documented Status is Unhealthy or Unavailable. HealthStatus uses the current Status column and falls back to legacy EndpointState when present.",
        "noDataMessage": "No unhealthy session hosts or failed health checks were found.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "SessionHostName",
              "label": "Session host",
              "width": "20ch"
            },
            {
              "columnId": "HealthStatus",
              "label": "AVD health",
              "width": "10ch"
            },
            {
              "columnId": "HealthCheck",
              "label": "Failed check",
              "width": "20ch"
            },
            {
              "columnId": "FailureMessage",
              "label": "Failure message",
              "width": "40ch"
            },
            {
              "columnId": "AgentVersion",
              "label": "Agent version",
              "width": "12ch"
            },
            {
              "columnId": "SxSStackVersion",
              "label": "SxS version",
              "width": "12ch"
            },
            {
              "columnId": "TimeGenerated",
              "label": "Observed (UTC)",
              "width": "18ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "HealthStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Unhealthy",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unavailable",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": "",
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Unhealthy session hosts and failed health checks",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,HostPool;WVDConnectionGraphicsDataPreview|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize ServerSkippedFramesPct=round(avg(ServerSkippedFramesPercentage),1),ClientSkippedFramesPct=round(avg(ClientSkippedFramesPercentage),1),NetworkSkippedFramesPct=round(avg(NetworkSkippedFramesPercentage),1),ServerEncodingDelayMs=round(avg(EncodingDelayOnServerInMs),1),ClientDecodingDelayMs=round(avg(DecodingTimeOnClientInMs),1),ClientRenderingTimeMs=round(avg(RenderingTimeOnClientInMs),1),Samples=count() by HostPool|order by NetworkSkippedFramesPct desc,ClientSkippedFramesPct desc",
        "size": 0,
        "title": "Graphics lag: server, network, or client",
        "description": "Graphics lag: server, network, or client. server-skipped frames or encoding delay point toward host CPU/GPU, encoder, image, or workload; network-skipped frames point toward packet loss or path instability; client-skipped frames or decoding/rendering delay point toward the endpoint. Use Session correlation details to capture a representative Correlation ID before querying optional graphics records. Next action: use the likely layer to choose the owning team, then use Session correlation details to capture a representative Correlation ID.",
        "noDataMessage": "No graphics samples matched. Confirm WVDConnectionGraphicsDataPreview collection, widen the time range, or clear user and host-pool filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "HostPool",
              "label": "Host pool"
            },
            {
              "columnId": "Samples",
              "label": "Samples",
              "width": "8ch"
            },
            {
              "columnId": "ServerSkippedFramesPct",
              "label": "Server skipped frames %",
              "width": "14ch"
            },
            {
              "columnId": "ClientSkippedFramesPct",
              "label": "Client skipped frames %",
              "width": "14ch"
            },
            {
              "columnId": "NetworkSkippedFramesPct",
              "label": "Network skipped frames %",
              "width": "14ch"
            },
            {
              "columnId": "ServerEncodingDelayMs",
              "label": "Server encoding (ms)",
              "width": "14ch"
            },
            {
              "columnId": "ClientDecodingDelayMs",
              "label": "Client decoding (ms)",
              "width": "14ch"
            },
            {
              "columnId": "ClientRenderingTimeMs",
              "label": "Client rendering (ms)",
              "width": "14ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "ServerSkippedFramesPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "ClientSkippedFramesPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "NetworkSkippedFramesPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "ServerEncodingDelayMs",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "15",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "ClientDecodingDelayMs",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "15",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "ClientRenderingTimeMs",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "15",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Graphics performance by host pool",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 4. Client and protocol\r\n**Start:** Client-version readiness. **Read:** Look for one version with more TCP fallback, high RTT, or low bandwidth than peers. TCP fallback is supported reverse-connect over TCP/TLS 443 when UDP Shortpath was not established or reported; it becomes a concern when elevated or worse than UDP. TURN is supported relayed UDP and is blue context. **Next:** Compare protocols, filter to one user, then use **Session correlation details** to identify the exact connection attempt before checking firewall, NAT, policy, and UDP reachability."
      },
      "name": "Client and path section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Links=WVDMultiLinkAdd\r\n| where TimeGenerated {TimeRange}\r\n| summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasUdp=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;\r\nlet Sessions=materialize(WVDConnections\r\n| where TimeGenerated {TimeRange} and State==\"Connected\"\r\n| summarize arg_max(TimeGenerated,*) by CorrelationId\r\n| join kind=leftouter Links on CorrelationId\r\n| extend HasTurn=coalesce(HasTurn,long(0)),HasUdp=coalesce(HasUdp,long(0)),HasWeb=coalesce(HasWeb,long(0))\r\n| extend Transport=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasUdp>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),ClientOS=iff(isempty(ClientOS),\"Unknown\",ClientOS),ClientType=iff(isempty(ClientType),\"Unknown\",ClientType),ClientVersion=iff(isempty(ClientVersion),\"Unknown\",ClientVersion)\r\n| extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)\r\n| where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))\r\n| project CorrelationId,ClientOS,ClientType,ClientVersion,Transport,User);\r\nlet Network=WVDConnectionNetworkData\r\n| where TimeGenerated {TimeRange}\r\n| join kind=inner (Sessions | project CorrelationId) on CorrelationId\r\n| summarize NetworkSamples=count(),P95RTTms=percentile(EstRoundTripTimeInMs,95),P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nSessions\r\n| join kind=leftouter Network on CorrelationId\r\n| summarize Sessions=count(),Users=dcount(User),NetworkSessions=countif(NetworkSamples>0),DirectUdpSessions=countif(Transport==\"UDP direct\"),TurnSessions=countif(Transport==\"UDP via TURN\"),TcpFallbackSessions=countif(Transport==\"TCP fallback\"),UnknownSessions=countif(Transport==\"Unknown\"),P95RTTms=round(max(P95RTTms),1),P10BandwidthMbps=round(min(P10BandwidthMbps),2) by ClientOS,ClientType,ClientVersion\r\n| extend DirectUdpPct=iff(Sessions==0,real(null),round(100.0*DirectUdpSessions/Sessions,1)),TurnPct=iff(Sessions==0,real(null),round(100.0*TurnSessions/Sessions,1)),TcpFallbackPct=iff(Sessions==0,real(null),round(100.0*TcpFallbackSessions/Sessions,1)),UnknownPct=iff(Sessions==0,real(null),round(100.0*UnknownSessions/Sessions,1)),NetworkCoveragePct=iff(Sessions==0,real(null),round(100.0*NetworkSessions/Sessions,1))\r\n| extend Status=case(NetworkCoveragePct<50,\"Unknown\",TcpFallbackPct>50 or P95RTTms>250 or P10BandwidthMbps<5,\"High\",TcpFallbackPct>20 or P95RTTms>120 or P10BandwidthMbps<10,\"Warning\",\"Healthy\"),StatusSort=case(NetworkCoveragePct<50,4,TcpFallbackPct>50 or P95RTTms>250 or P10BandwidthMbps<5,1,TcpFallbackPct>20 or P95RTTms>120 or P10BandwidthMbps<10,2,3)\r\n| extend Finding=case(NetworkCoveragePct<50,\"Insufficient network coverage\",TcpFallbackPct>50,\"High TCP fallback for this client version\",P95RTTms>250,\"High AVD round-trip time\",P10BandwidthMbps<5,\"Constrained AVD bandwidth\",TcpFallbackPct>20 or P95RTTms>120 or P10BandwidthMbps<10,\"Client/path warning threshold reached\",\"No client/path threshold exceeded\")\r\n| project Status,ClientOS,ClientType,ClientVersion,Finding,Sessions,Users,DirectUdpPct,TurnPct,TcpFallbackPct,UnknownPct,NetworkCoveragePct,P95RTTms,P10BandwidthMbps,StatusSort\r\n| order by StatusSort asc,TcpFallbackPct desc,Sessions desc\r\n| project-away StatusSort",
        "size": 0,
        "title": "Client version, transport, and network readiness",
        "description": "One row per client OS, type, and version. Status is driven by TCP fallback, unknown transport, network coverage, RTT, and bandwidth. TCP fallback is supported reverse-connect over TCP/TLS 443, not an error by itself; compare versions and investigate UDP path, policy, NAT, or firewall conditions when fallback is elevated. Blue Direct UDP or TURN percentages describe route mix.",
        "noDataMessage": "No client sessions matched. Widen the time range or clear host-pool, gateway, user, and transport filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "Status",
              "label": "Status",
              "width": "9ch"
            },
            {
              "columnId": "ClientOS",
              "label": "Client OS",
              "width": "1fr"
            },
            {
              "columnId": "ClientType",
              "label": "Client type",
              "width": "1fr"
            },
            {
              "columnId": "ClientVersion",
              "label": "Client version",
              "width": "14ch"
            },
            {
              "columnId": "Finding",
              "label": "Primary finding",
              "width": "1.3fr"
            },
            {
              "columnId": "Sessions",
              "label": "Sessions",
              "width": "8ch"
            },
            {
              "columnId": "Users",
              "label": "Users",
              "width": "7ch"
            },
            {
              "columnId": "DirectUdpPct",
              "label": "Direct UDP %",
              "width": "9ch"
            },
            {
              "columnId": "TurnPct",
              "label": "TURN %",
              "width": "8ch"
            },
            {
              "columnId": "TcpFallbackPct",
              "label": "TCP fallback %",
              "width": "10ch"
            },
            {
              "columnId": "UnknownPct",
              "label": "Unknown %",
              "width": "8ch"
            },
            {
              "columnId": "NetworkCoveragePct",
              "label": "Network coverage %",
              "width": "10ch"
            },
            {
              "columnId": "P95RTTms",
              "label": "RTT P95 ms",
              "width": "9ch"
            },
            {
              "columnId": "P10BandwidthMbps",
              "label": "Bandwidth P10 Mbps",
              "width": "11ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Healthy",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "High",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": "",
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "DirectUdpPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "50",
                    "representation": "blue",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "blue",
