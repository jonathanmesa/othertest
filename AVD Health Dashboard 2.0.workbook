    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,User,HostPool,Gateway,Mode,TimeGenerated);let UserSummary=C|summarize Sessions=count(),UdpSessions=countif(Mode in (\"UDP direct\",\"UDP via TURN\")),TcpSessions=countif(Mode==\"TCP fallback\"),UnknownSessions=countif(Mode==\"Unknown\"),HostPools=make_set(HostPool,5),Gateways=make_set(Gateway,5),LastSeen=max(TimeGenerated) by User|where UdpSessions==0;let UserErrorCounts=WVDErrors|where TimeGenerated {TimeRange}|extend Issue=iff(isempty(CodeSymbolic),strcat(\"Error \" ,tostring(Code)),CodeSymbolic)|join kind=inner C on CorrelationId|summarize IssueCount=count() by User,Issue;let UserErrors=UserErrorCounts|summarize ErrorCount=sum(IssueCount) by User;let TopErrorsPerUser=UserErrorCounts|order by User asc,IssueCount desc|summarize TopErrorsList=make_list(strcat(Issue,\" (\",tostring(IssueCount),\")\"),5) by User|extend TopErrors=strcat_array(TopErrorsList,\", \")|project User,TopErrors;UserSummary|join kind=leftouter UserErrors on User|join kind=leftouter TopErrorsPerUser on User|extend ErrorCount=coalesce(ErrorCount,long(0)),TopErrors=iff(isempty(TopErrors),\"None\",TopErrors)|project User,Sessions,TcpSessions,UnknownSessions,ErrorCount,TopErrors,HostPools,Gateways,LastSeen|order by ErrorCount desc,Sessions desc",
        "size": 0,
        "title": "Users who have never had a UDP connection",
        "description": "Shows users whose observed connected sessions did not establish direct or relayed UDP. TCP fallback is supported connectivity, not automatically a fault. Compare host pools, gateways, errors, and peers; then select the user in Session correlation details and inspect the exact Correlation IDs before escalating a UDP path issue.",
        "noDataMessage": "Every user matching the current filters had at least one UDP session (direct or relayed).",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
