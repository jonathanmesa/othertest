              "label": "Avg connected time (hr)",
              "width": "14ch"
            },
            {
              "columnId": "MedianConnectedHours",
              "label": "Median connected time (hr)",
              "width": "14ch"
            },
            {
              "columnId": "P95ConnectedHours",
              "label": "P95 connected time (hr)",
              "width": "14ch"
            },
            {
              "columnId": "NetworkCoverage_Pct",
              "label": "Network telemetry coverage %",
              "width": "12ch"
            },
