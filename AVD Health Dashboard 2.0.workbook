urationMinutes)),AvgConnectedHours=round(avg(DurationMinutes)/60.0,2),MedianConnectedHours=round(percentile(DurationMinutes,50)/60.0,2),P95ConnectedHours=round(percentile(DurationMinutes,95)/60.0,2) by User,Mode;let NetworkStats=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSessions=dcount(CorrelationId),NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by User,Mode;DurationStats|join kind=leftouter NetworkStats on User,Mode|extend NetworkSessions=coalesce(NetworkSessions,long(0)),NetworkSamples=coalesce(NetworkSamples,long(0))|extend NetworkCoverage_Pct=iff(Sessions==0,real(null),round(100.0*NetworkSessions/Sessions,1))|project User,Protocol=Mode,Sessions,DisconnectedSessions,AvgConnectedHours,MedianConnectedHours,P95ConnectedHours,NetworkCoverage_Pct,AvgRTTms,P95RTTms,AvgBandwidthMbps,P10BandwidthMbps|order by User asc,Sessions desc",
