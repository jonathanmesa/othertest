              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "2",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "10",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "Status",
              "label": "AVD evidence status",
              "width": "18ch"
            },
            {
              "columnId": "PrimarySignal",
              "label": "Why",
              "width": "28ch"
            },
            {
              "columnId": "Evidence",
              "label": "Evidence quality",
              "width": "12ch"
            },
            {
              "columnId": "P95RTTms",
              "label": "P95 RTT (ms)",
              "width": "12ch"
            },
            {
