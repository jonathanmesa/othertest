      "type": 1,
      "content": {
        "json": "## 5. Errors and session evidence\r\n**Start:** Grouped errors, then top error codes. **Read:** Affected attempts matter more than repeated messages from one attempt. **Next:** Filter to one user in **Session correlation details**, copy the Correlation ID, and retrieve the complete event sequence from AVD diagnostic tables."
      },
      "name": "Error investigation section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);let C=materialize(WVDConnections|where TimeGenerated {TimeRange}|summarize arg_max(TimeGenerated,*),StartedAt=minif(TimeGenerated,State==\"Started\"),ConnectedAt=minif(TimeGenerated,State==\"Connected\"),DisconnectedAt=minif(TimeGenerated,State in~ (\"Disconnected\",\"Completed\",\"Canceled\",\"Cancelled\",\"Failed\",\"SessionEnded\")) by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),Outcome=iff(isnotempty(ConnectedAt),\"Connected\",\"Not connected\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),ClientIP=iff(isempty(ClientSideIPAddress),\"Unknown\",ClientSideIPAddress),SessionHost=iff(isempty(SessionHostName),\"Unknown\",SessionHostName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool),DurationMinutes=iff(isnotempty(ConnectedAt) and isnotempty(DisconnectedAt),datetime_diff('minute',DisconnectedAt,ConnectedAt),long(null))|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId,Outcome,Transport,User,ClientIP,HostPool,Gateway,SessionHost,DurationMinutes);let ErrorGroups=WVDErrors|where TimeGenerated {TimeRange}|extend Category=case(ActivityType has \"Host\" or Operation has \"Registration\",\"Host or agent\",ActivityType has \"Connection\" or Operation has \"Connection\",\"Connection setup\",ActivityType has \"Management\",\"Resource management\",ActivityType has \"Feed\",\"Workspace or assignment\",\"Other AVD activity\"),Issue=iff(isempty(CodeSymbolic),strcat(\"Error \" ,tostring(Code)),CodeSymbolic)|join kind=inner C on CorrelationId|summarize Errors=count(),AffectedAttempts=dcount(CorrelationId),ServiceErrors=countif(ServiceError==true),Issues=make_set(Issue,10),Messages=make_set(Message,5),Categories=make_set(Category,5),Sources=make_set(Source,5),HostPools=make_set(HostPool,10),SessionHosts=make_set(SessionHost,10),Gateways=make_set(Gateway,10),AvgConnectedHours=round(avg(DurationMinutes)/60.0,2),P95ConnectedHours=round(percentile(DurationMinutes,95)/60.0,2),LastSeen=max(TimeGenerated),SampleCorrelationIds=make_set(CorrelationId,5) by User,ClientIP,Outcome,Transport;let TopErrorsPerGroup=WVDErrors|where TimeGenerated {TimeRange}|extend Issue=iff(isempty(CodeSymbolic),strcat(\"Error \" ,tostring(Code)),CodeSymbolic)|join kind=inner C on CorrelationId|summarize IssueCount=count() by User,ClientIP,Outcome,Transport,Issue|order by User asc,ClientIP asc,Outcome asc,Transport asc,IssueCount desc|summarize TopErrorsList=make_list(strcat(Issue,\" (\",tostring(IssueCount),\")\"),5) by User,ClientIP,Outcome,Transport|extend TopErrors=strcat_array(TopErrorsList,\", \")|project User,ClientIP,Outcome,Transport,TopErrors;let NetworkGroups=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSessions=dcount(CorrelationId),NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by User,ClientIP,Outcome,Transport;ErrorGroups|join kind=leftouter NetworkGroups on User,ClientIP,Outcome,Transport|join kind=leftouter TopErrorsPerGroup on User,ClientIP,Outcome,Transport|extend NetworkSessions=coalesce(NetworkSessions,long(0)),NetworkSamples=coalesce(NetworkSamples,long(0)),TopErrors=iff(isempty(TopErrors),\"None\",TopErrors)|top 50 by Errors desc|project User,ClientIP,Outcome,Transport,Errors,AffectedAttempts,ServiceErrors,AvgConnectedHours,P95ConnectedHours,TopErrors,Issues,Messages,Categories,Sources,HostPools,SessionHosts,Gateways,NetworkSessions,NetworkSamples,AvgRTTms,P95RTTms,AvgBandwidthMbps,P10BandwidthMbps,LastSeen,SampleCorrelationIds",
        "size": 0,
