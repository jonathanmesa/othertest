      "name": "Top errors by affected attempts",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=WVDConnections|where TimeGenerated {TimeRange}|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|project CorrelationId;let FilteredErrors=WVDErrors|where TimeGenerated {TimeRange}|extend Error=iff(isempty(CodeSymbolic),strcat(\"Error \",tostring(Code)),CodeSymbolic),Origin=iff(ServiceError==true,\"Microsoft service\",\"Environment/configuration\")|join kind=inner C on CorrelationId;let TopErrors=FilteredErrors|summarize AffectedAttempts=dcount(CorrelationId) by Error|top 10 by AffectedAttempts desc|project Error;FilteredErrors|where Error in (TopErrors)|summarize ErrorMessages=count(),AffectedAttempts=dcount(CorrelationId) by bin(TimeGenerated,{TimeRange:grain}),Error,Origin|order by TimeGenerated asc",
        "size": 0,
        "title": "Error trend over time",
        "description": "Tracks the top 10 error codes by time bucket for the selected filters. Error messages counts every correlated WVDErrors event, while affected attempts counts distinct connection attempts. Use the lines to see which errors are increasing or decreasing; a rise in affected attempts is more significant than repeated messages from one noisy attempt. The query also returns the error origin so the code can be compared with the service-versus-environment classification in the detailed error table.",
        "noDataMessage": "No matching connection errors were collected for the selected period and filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "timechart",
        "chartSettings": {
          "xAxis": "TimeGenerated",
          "yAxis": [
            "ErrorMessages"
          ],
          "group": "Error",
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "ErrorMessages",
              "label": "Error messages"
            }
          ]
        }
      },
      "name": "Error trend over time",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 6. Trends and geography\r\n**Start:** Use transport, session, RTT, and bandwidth trends after a protocol or timing pattern is suspected. **Read:** Compare protocol, gateway, client location, and host-pool patterns; trends identify scope, not a single attempt. **Next:** Return to **Session correlation details**, select a user and matching time, and copy the Correlation ID for the concrete example behind the pattern."
      },
      "name": "Expanded transport analytics section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|extend Detail=case(Mode==\"UDP via TURN\",\"UDP via TURN (relay)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"1\",\"UDP direct (managed/private)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"2\",\"UDP direct (public/STUN)\",Mode==\"UDP direct\",\"UDP direct (evidence-based)\",Mode==\"TCP fallback\",\"TCP fallback\",\"Unknown\")|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|summarize Sessions=count() by bin(TimeGenerated,{TimeRange:grain}),Detail|order by TimeGenerated asc",
        "size": 1,
        "title": "Session transport trend",
        "noDataMessage": "No connected-session transport data matched. Widen the time range or clear host-pool, gateway, user, and transport filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "timechart",
        "description": "Shows how connected sessions move between direct UDP, relayed UDP (TURN), supported TCP/TLS 443 fallback, and unknown transport over time. A sudden move toward TCP is more useful than the absolute mix alone and can point to a UDP Shortpath, firewall, NAT, or policy change; TCP fallback by itself is not a failure."
      },
      "customWidth": "100",
      "name": "Session transport trend",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|summarize ConnectionAttempts=dcount(CorrelationId),ConnectedSessions=dcountif(CorrelationId,State==\"Connected\"),NonConnectedAttempts=dcountif(CorrelationId,State!=\"Connected\") by bin(TimeGenerated,{TimeRange:grain})|order by TimeGenerated asc",
        "size": 1,
        "title": "Session count historical trend",
        "description": "Shows distinct connection attempts over time, split into sessions that reached Connected and attempts that did not. Use this to spot changes in demand, connection success, or a sudden rise in failed or incomplete attempts. Time buckets follow the selected time range grain and the panel uses the current host pool, gateway, and user filters.",
        "noDataMessage": "No connection attempts were found for the selected filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "timechart",
        "chartSettings": {
          "xAxis": "TimeGenerated",
          "yAxis": [
            "ConnectionAttempts",
            "ConnectedSessions",
            "NonConnectedAttempts"
          ],
          "showLegend": true
        }
      },
      "customWidth": "100",
      "name": "Session count historical trend",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|extend Detail=case(Mode==\"UDP via TURN\",\"UDP via TURN (relay)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"1\",\"UDP direct (managed/private)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"2\",\"UDP direct (public/STUN)\",Mode==\"UDP direct\",\"UDP direct (evidence-based)\",Mode==\"TCP fallback\",\"TCP fallback\",\"Unknown\")|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|project CorrelationId,Detail;WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize AvgRTTms=round(avg(EstRoundTripTimeInMs),1) by bin(TimeGenerated,{TimeRange:grain}),Detail|order by TimeGenerated asc",
        "size": 1,
        "title": "RTT trend by protocol (lower is better)",
        "description": "Tracks average round-trip time in milliseconds over time, one line per transport sub-type (managed/private direct, public/STUN direct, TURN relay, TCP fallback, or Unknown), from WVDConnectionNetworkData samples for sessions matching the current filters. Use this to see whether a protocol's latency is stable, improving, or degrading across the selected time range — a single-point average can hide a protocol that was fine yesterday but is getting worse now. Pair with the bandwidth trend to the right and the 'Protocol comparison' table below for the full point-in-time picture.",
        "noDataMessage": "No RTT samples were correlated to the filtered sessions.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "timechart",
        "chartSettings": {
          "xAxis": "TimeGenerated",
          "yAxis": [
            "AvgRTTms"
          ],
          "group": "Detail",
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "AvgRTTms",
              "label": "Avg RTT (ms)"
            }
          ]
        }
      },
      "customWidth": "50",
      "name": "RTT trend by protocol",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|extend Detail=case(Mode==\"UDP via TURN\",\"UDP via TURN (relay)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"1\",\"UDP direct (managed/private)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"2\",\"UDP direct (public/STUN)\",Mode==\"UDP direct\",\"UDP direct (evidence-based)\",Mode==\"TCP fallback\",\"TCP fallback\",\"Unknown\")|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|project CorrelationId,Detail;WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2) by bin(TimeGenerated,{TimeRange:grain}),Detail|order by TimeGenerated asc",
        "size": 1,
        "title": "Bandwidth trend by protocol (higher is better)",
        "description": "Tracks average estimated available bandwidth in Mbps over time, one line per transport sub-type (managed/private direct, public/STUN direct, TURN relay, TCP fallback, or Unknown), from WVDConnectionNetworkData samples for sessions matching the current filters. Use this alongside the RTT trend to the left to see whether a protocol's speed is holding steady or dropping off at particular times — a protocol that looks fine on average in the 'Protocol comparison' table below may still have a bandwidth dip during business hours that this trend will reveal.",
        "noDataMessage": "No bandwidth samples were correlated to the filtered sessions.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "timechart",
        "chartSettings": {
          "xAxis": "TimeGenerated",
          "yAxis": [
            "AvgBandwidthMbps"
          ],
          "group": "Detail",
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "AvgBandwidthMbps",
              "label": "Avg bandwidth (Mbps)"
            }
          ]
        }
      },
      "customWidth": "50",
      "name": "Bandwidth trend by protocol",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend HasTurn=coalesce(HasTurn,long(0)),HasShort=coalesce(HasShort,long(0)),HasWeb=coalesce(HasWeb,long(0))|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|project CorrelationId,Gateway,Mode,UdpUse,UserName);let Mix=C|summarize Sessions=count(),Users=dcount(UserName),Direct=countif(Mode==\"UDP direct\"),ManagedDirect=countif(Mode==\"UDP direct\" and tostring(UdpUse)==\"1\"),PublicDirect=countif(Mode==\"UDP direct\" and tostring(UdpUse)==\"2\"),Relayed=countif(Mode==\"UDP via TURN\"),TCP=countif(Mode==\"TCP fallback\"),Unknown=countif(Mode==\"Unknown\") by Gateway|extend Direct_UDP_Pct=iff(Sessions==0,real(null),round(100.0*Direct/Sessions,1)),ManagedDirect_Pct=iff(Sessions==0,real(null),round(100.0*ManagedDirect/Sessions,1)),PublicDirect_Pct=iff(Sessions==0,real(null),round(100.0*PublicDirect/Sessions,1)),Relayed_UDP_Pct=iff(Sessions==0,real(null),round(100.0*Relayed/Sessions,1)),TCP_Pct=iff(Sessions==0,real(null),round(100.0*TCP/Sessions,1)),Unknown_Pct=iff(Sessions==0,real(null),round(100.0*Unknown/Sessions,1));let Bandwidth=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner (C|project CorrelationId,Gateway) on CorrelationId|summarize SampledSessions=dcount(CorrelationId),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2) by Gateway;Mix|join kind=leftouter Bandwidth on Gateway|extend SampledSessions=coalesce(SampledSessions,long(0))|extend NetworkCoverage_Pct=iff(Sessions==0,real(null),round(100.0*SampledSessions/Sessions,1))|project Gateway,Sessions,Users,Direct_UDP_Pct,ManagedDirect_Pct,PublicDirect_Pct,Relayed_UDP_Pct,TCP_Pct,Unknown_Pct,NetworkCoverage_Pct,AvgRTTms,AvgBandwidthMbps|order by TCP_Pct desc,Unknown_Pct desc,Sessions desc",
        "size": 0,
        "title": "Transport mix by gateway region",
        "description": "One row per AVD gateway region for connected sessions matching the current filters. TCP fallback is supported TCP/TLS 443 connectivity; compare its share, unknown transport, RTT, bandwidth, and coverage across regions. Concentrated fallback with worse network metrics can indicate a regional UDP path issue. Compare the session-host drill-down to distinguish gateway from host concentration.",
        "noDataMessage": "No gateway rows matched. Widen the time range or clear gateway, user, and transport filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "Gateway",
              "label": "Gateway region"
            },
            {
              "columnId": "Sessions",
              "label": "Sessions",
              "width": "8ch"
            },
            {
              "columnId": "Users",
              "label": "Users",
              "width": "8ch"
            },
            {
              "columnId": "Direct_UDP_Pct",
              "label": "Direct UDP %",
              "width": "10ch"
            },
            {
              "columnId": "ManagedDirect_Pct",
              "label": "Direct via Managed/Private Network %",
              "width": "10ch"
            },
            {
              "columnId": "PublicDirect_Pct",
              "label": "Direct via Public Network (STUN) %",
              "width": "10ch"
            },
            {
              "columnId": "Relayed_UDP_Pct",
              "label": "Relayed via TURN %",
              "width": "10ch"
            },
            {
              "columnId": "TCP_Pct",
              "label": "TCP Fallback %",
              "width": "10ch"
            },
            {
              "columnId": "Unknown_Pct",
              "label": "Unknown Transport %",
              "width": "10ch"
            },
            {
              "columnId": "NetworkCoverage_Pct",
              "label": "Network Telemetry Coverage %",
              "width": "10ch"
            },
            {
              "columnId": "AvgRTTms",
              "label": "Avg RTT (ms)",
              "width": "10ch"
            },
            {
              "columnId": "AvgBandwidthMbps",
              "label": "Avg bandwidth (Mbps)",
              "width": "12ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "TCP_Pct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "Unknown_Pct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "0",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "NetworkCoverage_Pct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "80",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "Transport mix by gateway region",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,HostPool,Gateway,User,ClientSideIPAddress;WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|extend Geo=geo_info_from_ip_address(ClientSideIPAddress)|extend Country=iff(isempty(tostring(Geo.country)),\"Unknown\",tostring(Geo.country)),Location=strcat(iff(isempty(tostring(Geo.city)),\"Unknown\",tostring(Geo.city)),\" | Gateway: \",Gateway),latitude=toreal(Geo.latitude),longitude=toreal(Geo.longitude)|where isnotnull(latitude) and isnotnull(longitude)|summarize Sessions=dcount(CorrelationId),NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2) by Location,Country,Gateway,latitude,longitude|order by AvgRTTms desc",
        "size": 1,
        "title": "World heat map by client location",
        "description": "Maps correlated AVD network telemetry by approximate client public-IP location and Azure gateway region. Redder areas indicate higher average RTT; larger markers represent more sessions. The map label includes the client city and gateway region so regional client-path patterns can be compared with the gateway-region table. Locations are approximate and may be absent for private or unrecognized addresses.",
        "noDataMessage": "No geolocated network samples were found for the selected filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "map",
        "mapSettings": {
          "locInfo": "LatLong",
          "locInfoColumn": "Location",
          "latitude": "latitude",
          "longitude": "longitude",
          "sizeSettings": "Sessions",
          "sizeAggregation": "Sum",
          "labelSettings": "Location",
          "legendMetric": "AvgRTTms",
          "legendAggregation": "Average",
          "itemColorSettings": {
            "nodeColorField": "AvgRTTms",
            "colorAggregation": "Average",
            "type": "heatmap",
            "heatmapPalette": "greenRed",
            "heatmapMin": 0,
            "heatmapMax": 500
          },
          "numberFormatSettings": {
            "unit": 23,
            "options": {
              "style": "decimal",
              "maximumFractionDigits": 0
            },
            "emptyValCustomText": "Unknown"
          }
        }
      },
      "customWidth": "100",
      "name": "World heat map by client location",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|project CorrelationId,HostPool,Gateway,User,ClientSideIPAddress;WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|extend Geo=geo_info_from_ip_address(ClientSideIPAddress)|extend Country=iff(isempty(tostring(Geo.country)),\"Unknown\",tostring(Geo.country)),City=iff(isempty(tostring(Geo.city)),\"Unknown\",tostring(Geo.city))|summarize Sessions=dcount(CorrelationId),NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by Country,City|order by P95RTTms desc,Sessions desc",
        "size": 0,
        "title": "RTT and bandwidth by client location",
        "description": "Correlates WVDConnectionNetworkData with approximate country and city data derived from the client public IP. Use P95 RTT and P10 bandwidth to find locations where a meaningful share of sessions has poor network conditions, not just an unusually high average. Geolocation is approximate, may be unavailable for private or unrecognized addresses, and should be used for regional pattern detection rather than exact user identification.",
        "noDataMessage": "No geolocated network rows matched. Private or unrecognized client IPs cannot be mapped; also verify network collection.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "Country",
              "label": "Country"
            },
            {
              "columnId": "City",
              "label": "City"
            },
            {
              "columnId": "Sessions",
              "label": "Sessions",
              "width": "8ch"
            },
            {
              "columnId": "NetworkSamples",
              "label": "Network samples",
              "width": "12ch"
            },
            {
              "columnId": "AvgRTTms",
              "label": "Avg RTT (ms)",
              "width": "10ch"
            },
            {
              "columnId": "P95RTTms",
              "label": "P95 RTT (ms)",
              "width": "10ch"
            },
            {
              "columnId": "AvgBandwidthMbps",
              "label": "Avg bandwidth (Mbps)",
              "width": "12ch"
            },
            {
              "columnId": "P10BandwidthMbps",
              "label": "P10 bandwidth (Mbps)",
              "width": "12ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "10",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ]
        }
      },
      "name": "RTT and bandwidth by client location",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;WVDConnections|where TimeGenerated {TimeRange}|summarize ConnectedAt=minif(TimeGenerated,State==\"Connected\"),DisconnectedAt=minif(TimeGenerated,State in~ (\"Disconnected\",\"Completed\",\"Canceled\",\"Cancelled\",\"Failed\",\"SessionEnded\")),arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|extend DurationMinutes=iff(isnotempty(ConnectedAt) and isnotempty(DisconnectedAt),datetime_diff('minute',DisconnectedAt,ConnectedAt),long(null))|summarize Sessions=count(),DisconnectedSessions=countif(isnotempty(DisconnectedAt)),AvgConnectedHours=round(avg(DurationMinutes)/60.0,2),P95ConnectedHours=round(percentile(DurationMinutes,95)/60.0,2) by HostPool,Mode|order by HostPool asc,AvgConnectedHours desc",
        "size": 0,
        "title": "Average connected time by host pool and protocol",
        "description": "Compares average connected duration in hours by host pool, grouped by protocol. Shorter TCP sessions than UDP strengthen a transport-stability hypothesis. Open Analytics or export the result to inspect session counts, P95 duration, and how many sessions had a disconnect event.",
        "noDataMessage": "No connected session duration data was found for the selected filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "categoricalbar",
        "chartSettings": {
          "xAxis": "HostPool",
          "yAxis": [
            "AvgConnectedHours"
          ],
          "group": "Mode",
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "AvgConnectedHours",
              "label": "Average connected hours"
            }
          ]
        }
      },
      "name": "Average connected time by host pool",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 7. Operational changes and unused hosts\r\n**Start:** For cost review, open **Session hosts above the inactivity threshold**. For incidents aligned with a deployment or resource change, use registration, management, and provisioning panels. **Read:** Gray unused-host rows need inventory or retention verification; orange rows are candidates, not confirmed waste. **Next:** Confirm assignments and business intent before draining, deallocating, or removing a host. Use CorrelationId for related errors when available."
      },
      "name": "Optional operational diagnostics section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool,SessionHostName;WVDHostRegistrations|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|join kind=inner C on HostPool,SessionHostName|summarize Registrations=count(),FirstRegistration=min(TimeGenerated),LastRegistration=max(TimeGenerated),PrivateLink=make_set(IsSessionHostPrivateLink,2),Addresses=make_set(SessionHostIPAddress,3) by HostPool,SessionHostName|order by LastRegistration desc",
        "size": 0,
        "title": "Session host registration activity",
        "description": "Use this after hosts are added, rebuilt, or updated. Each row shows when a session host last registered with AVD. Repeated or unexpected registrations can identify hosts changed around the start of a user-experience issue.",
        "noDataMessage": "No WVDHostRegistrations records were found. Enable the Host Registration diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table"
      },
      "customWidth": "100",
      "name": "Session host registration activity",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let IdleDays=toint({UnusedDays});\nlet Inventory=WVDAgentHealthStatus\r\n| where TimeGenerated > ago(90d) and isnotempty(SessionHostName)\r\n| extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),HostKey=tolower(tostring(split(SessionHostName,\".\")[0]))\r\n| extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)\r\n| summarize arg_max(TimeGenerated,*) by HostPool,HostKey\r\n| extend HealthStatus=tostring(column_ifexists(\"Status\",column_ifexists(\"EndpointState\",\"Unknown\"))),LatestActiveSessions=toint(ActiveSessions),AcceptingSessions=tostring(AllowNewSessions)\r\n| project HostPool,HostKey,SessionHost=SessionHostName,HealthStatus,LatestActiveSessions,AcceptingSessions,LastHealthReportUtc=TimeGenerated;\r\nlet Usage=WVDConnections\r\n| where TimeGenerated > ago(90d) and State==\"Connected\" and isnotempty(SessionHostName)\r\n| extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),HostKey=tolower(tostring(split(SessionHostName,\".\")[0]))\r\n| extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)\r\n| summarize arg_max(TimeGenerated,UserName) by HostPool,HostKey\r\n| project HostPool,HostKey,LastSessionUtc=TimeGenerated,LastUser=UserName;\r\nInventory\r\n| join kind=leftouter Usage on HostPool,HostKey\r\n| extend DaysSinceLastSession=iff(isnull(LastSessionUtc),long(null),datetime_diff(\"day\",now(),LastSessionUtc)),DaysSinceHealthReport=datetime_diff(\"day\",now(),LastHealthReportUtc)\r\n| where isnull(LastSessionUtc) or DaysSinceLastSession >= IdleDays\r\n| where isnull(LatestActiveSessions) or LatestActiveSessions==0\r\n| where 'All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})\r\n| extend Status=case(DaysSinceHealthReport>30,\"Verify inventory\",isnull(LastSessionUtc),\"No session found\",\"Review\"),Finding=case(DaysSinceHealthReport>30,\"Host evidence is older than 30 days\",isnull(LastSessionUtc),\"No connected session found in the 90-day search\",strcat(\"No connected session for \",DaysSinceLastSession,\" days\")),NextAction=case(DaysSinceHealthReport>30,\"Confirm the host still exists before taking action\",isnull(LastSessionUtc),\"Verify retention, assignments, and business purpose\",AcceptingSessions =~ \"true\",\"Confirm demand; drain before deallocation or removal\",\"Confirm business need before deallocation or removal\")\r\n| project Status,SessionHost,HostPool,DaysSinceLastSession,LastSessionUtc,LastUser,HealthStatus,AcceptingSessions,LatestActiveSessions,LastHealthReportUtc,Finding,NextAction\r\n| order by Status asc,DaysSinceLastSession desc,HostPool asc,SessionHost asc",
        "size": 0,
        "title": "Session hosts above the inactivity threshold",
        "description": "Cost and inventory review for session hosts seen in agent-health data during the last 90 days but with no connected session for the selected inactivity threshold (30 days by default). This fixed history search ignores the dashboard time picker. Orange Review rows have recent host evidence; gray rows need inventory or retention verification. Confirm assignments, maintenance intent, power state, and business approval before draining, deallocating, or removing a host.",
        "noDataMessage": "No unused-host candidates were found in the 90-day search. If hosts are expected, verify WVDAgentHealthStatus and WVDConnections collection and Log Analytics retention.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Review",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            }
          ],
          "labelSettings": [
            {
              "columnId": "Status",
              "label": "Review status",
              "width": "14ch"
            },
            {
              "columnId": "SessionHost",
              "label": "Session host",
              "width": "22ch"
            },
            {
              "columnId": "HostPool",
              "label": "Host pool",
              "width": "18ch"
            },
            {
              "columnId": "DaysSinceLastSession",
              "label": "Days since session",
              "width": "12ch"
            },
            {
              "columnId": "LastSessionUtc",
              "label": "Last session (UTC)",
              "width": "18ch"
            },
            {
              "columnId": "LastUser",
              "label": "Last user",
              "width": "22ch"
            },
            {
              "columnId": "HealthStatus",
              "label": "Latest health",
              "width": "12ch"
            },
            {
              "columnId": "AcceptingSessions",
              "label": "Allows sessions",
              "width": "11ch"
            },
            {
              "columnId": "LatestActiveSessions",
              "label": "Latest active",
              "width": "10ch"
            },
            {
              "columnId": "LastHealthReportUtc",
              "label": "Host evidence (UTC)",
              "width": "18ch"
            },
            {
              "columnId": "Finding",
              "label": "Finding",
              "width": "30ch"
            },
            {
              "columnId": "NextAction",
              "label": "Next action",
              "width": "38ch"
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "Unused session host candidates",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool;WVDManagement|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Scope=iff(isempty(ArmObjectScope),\"Unknown\",ArmObjectScope),Actor=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where HostPool in (C)|summarize Operations=count(),Created=sum(ObjectsCreated),Updated=sum(ObjectsUpdated),Deleted=sum(ObjectsDeleted),FirstSeen=min(TimeGenerated),LastSeen=max(TimeGenerated),SampleActors=make_set(Actor,5) by HostPool,Scope,Route,ProvisioningCorrelationId|order by LastSeen desc",
        "size": 0,
        "title": "AVD management changes near an incident",
        "description": "Use this to find AVD resource changes that occurred before symptoms began. Each row is a management route and scope. Review recent creates, updates, and deletes before attributing a broad regression to the network path.",
        "noDataMessage": "No WVDManagement records were found. Enable the Management diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table"
      },
      "customWidth": "100",
      "name": "AVD management changes",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))|distinct HostPool;WVDSessionHostManagement|where TimeGenerated {TimeRange}|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where HostPool in (C)|project TimeGenerated,HostPool,ProvisioningType,ProvisioningStatus,FromInstanceCount,ToInstanceCount,FromSessionHostConfigVer,ToSessionHostConfigVer,UpdateMethod,ScheduledDateTime,CorrelationId|order by TimeGenerated desc",
        "size": 0,
        "title": "Session host provisioning and updates",
        "description": "Use this when the issue followed host provisioning, image rollout, or host configuration change. Each row is an AVD session-host management operation. Failed status or a configuration-version change identifies a specific deployment window to compare with affected users.",
        "noDataMessage": "No WVDSessionHostManagement records were found. Enable the Session Host Management diagnostic category if this evidence is needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table"
      },
      "customWidth": "100",
      "name": "Session host provisioning and updates",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## Complete the application root-cause record outside this workbook\r\n- **Application telemetry:** application-specific latency, failure, service health, client diagnostics, and timestamps.\r\n- **Network and security telemetry:** proxy, DNS, identity, firewall, TLS inspection, and content-path evidence.\r\n- **Profile and endpoint telemetry:** profile behavior, endpoint configuration, and client-side evidence where relevant.\r\n- **Correlation rule:** compare the same user and time window. Healthy AVD evidence during poor application telemetry shifts investigation toward the application, service, profile, endpoint, proxy, or content path."
      },
      "name": "App evidence checklist",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    }
  ],
  "fallbackResourceIds": [
    "Azure Monitor"
  ],
  "$schema": "https://github.com/Microsoft/Application-Insights-Workbooks/blob/master/schema/workbook.json",
  "layout": {
    "type": "flow"
  }
}
