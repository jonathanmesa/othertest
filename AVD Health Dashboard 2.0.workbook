    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=WVDConnections|where TimeGenerated {TimeRange}|summarize arg_max(TimeGenerated,*),ConnectedAt=minif(TimeGenerated,State==\"Connected\") by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId;WVDErrors|where TimeGenerated {TimeRange}|extend Error=iff(isempty(CodeSymbolic),strcat(\"Error \" ,tostring(Code)),CodeSymbolic),Origin=iff(ServiceError==true,\"Microsoft service\",\"Environment/configuration\")|join kind=inner C on CorrelationId|summarize AffectedAttempts=dcount(CorrelationId) by Error,Origin|top 10 by AffectedAttempts desc",
        "size": 1,
        "title": "Top errors by affected connection attempts",
        "description": "Ranks error signatures by distinct affected connection attempts, so repeated messages from one attempt do not dominate. Use Grouped connection errors to identify the affected user or device, then use Session correlation details to copy the exact Correlation ID.",
        "noDataMessage": "No matching connection errors were collected. Widen the time range or clear filters before concluding there were no errors.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "categoricalbar",
        "chartSettings": {
          "xAxis": "Error",
          "yAxis": [
            "AffectedAttempts"
          ],
          "group": "Origin",
          "showLegend": true,
          "seriesLabelSettings": [
            {
              "seriesName": "Microsoft service",
              "label": "Microsoft service",
              "color": "red"
            },
            {
              "seriesName": "Environment/configuration",
              "label": "Environment/configuration",
              "color": "orange"
