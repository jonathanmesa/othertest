      },
      "customWidth": "100",
      "name": "Host pool performance and user density",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let Links=WVDMultiLinkAdd\r\n| where TimeGenerated {TimeRange}\r\n| summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasUdp=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;\r\nlet Connections=materialize(WVDConnections\r\n| where TimeGenerated {TimeRange} and State==\"Connected\"\r\n| summarize arg_max(TimeGenerated,*) by CorrelationId\r\n| extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),SessionHost=tostring(SessionHostName)\r\n| extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)\r\n| where isnotempty(SessionHost)\r\n| where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))\r\n| extend HostKey=tolower(tostring(split(SessionHost,\".\")[0]))\r\n| project CorrelationId,HostPool,SessionHost,HostKey,User,TransportType,UdpUse);\r\nlet HostMap=Connections | summarize SessionHost=any(SessionHost),HostPool=any(HostPool),UsersInRange=dcountif(User,User != \"Unknown\") by HostKey;\r\nlet Connected=materialize(Connections\r\n| join kind=leftouter Links on CorrelationId\r\n| extend HasTurn=coalesce(HasTurn,long(0)),HasUdp=coalesce(HasUdp,long(0)),HasWeb=coalesce(HasWeb,long(0))\r\n| extend Transport=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasUdp>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\")\r\n| where ('All' in ({TransportFilter}) or Transport in ({TransportFilter})));\r\nlet TransportByHost=Connected\r\n| summarize ConnectedSessions=dcount(CorrelationId),TcpFallbackSessions=dcountif(CorrelationId,Transport==\"TCP fallback\") by HostKey\r\n| extend TcpFallbackPct=iff(ConnectedSessions==0,real(null),round(100.0*TcpFallbackSessions/ConnectedSessions,1));\r\nlet NetworkByHost=WVDConnectionNetworkData\r\n| where TimeGenerated {TimeRange}\r\n| join kind=inner (Connected | project CorrelationId,HostKey) on CorrelationId\r\n| summarize NetworkSessions=dcount(CorrelationId),NetworkSamples=count(),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by HostKey;\r\nlet CpuPerf=Perf\r\n| where TimeGenerated {TimeRange} and isnotempty(Computer)\r\n| where CounterName =~ \"% Processor Time\" and InstanceName =~ \"_Total\"\r\n| extend HostKey=tolower(tostring(split(Computer,\".\")[0]))\r\n| join kind=inner HostMap on HostKey\r\n| summarize CpuSamples=count(),CpuP95Pct=round(percentile(CounterValue,95),1) by HostKey;\r\nlet MemoryPerf=Perf\r\n| where TimeGenerated {TimeRange} and isnotempty(Computer)\r\n| where CounterName in~ (\"% Committed Bytes In Use\",\"% Used Memory\")\r\n| extend HostKey=tolower(tostring(split(Computer,\".\")[0]))\r\n| join kind=inner HostMap on HostKey\r\n| summarize MemorySamples=count(),MemoryUsedP95Pct=round(percentile(CounterValue,95),1) by HostKey;\r\nlet Health=WVDAgentHealthStatus\r\n| where TimeGenerated {TimeRange} and isnotempty(SessionHostName)\r\n| extend HostKey=tolower(tostring(split(SessionHostName,\".\")[0]))\r\n| summarize arg_max(TimeGenerated,*) by HostKey\r\n| extend HealthStatus=tostring(column_ifexists(\"Status\",column_ifexists(\"EndpointState\",\"Unknown\")))\r\n| project HostKey,HealthStatus,LatestActiveSessions=toint(ActiveSessions);\r\nHostMap\r\n| join kind=leftouter CpuPerf on HostKey\r\n| join kind=leftouter MemoryPerf on HostKey\r\n| join kind=leftouter Health on HostKey\r\n| join kind=leftouter TransportByHost on HostKey\r\n| join kind=leftouter NetworkByHost on HostKey\r\n| extend LatestActiveSessions=coalesce(LatestActiveSessions,0),ConnectedSessions=coalesce(ConnectedSessions,long(0)),NetworkSessions=coalesce(NetworkSessions,long(0)),CounterCoverage=case(CpuSamples>0 and MemorySamples>0,\"CPU + memory\",CpuSamples>0,\"CPU only\",MemorySamples>0,\"Memory only\",\"Missing\")\r\n| extend NetworkCoveragePct=iff(ConnectedSessions==0,real(null),round(100.0*NetworkSessions/ConnectedSessions,1))\r\n| extend Status=case(HealthStatus in~ (\"Unhealthy\",\"Unavailable\") or CpuP95Pct>=85 or MemoryUsedP95Pct>=90 or (NetworkCoveragePct>=50 and (P95RTTms>250 or P10BandwidthMbps<5 or TcpFallbackPct>50)),\"High\",CounterCoverage==\"Missing\" and NetworkCoveragePct==0,\"Unknown\",CounterCoverage!=\"CPU + memory\" or CpuSamples<20 or MemorySamples<20 or NetworkCoveragePct<50 or CpuP95Pct>=70 or MemoryUsedP95Pct>=80 or P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20,\"Warning\",\"Healthy\"),StatusSort=case(HealthStatus in~ (\"Unhealthy\",\"Unavailable\") or CpuP95Pct>=85 or MemoryUsedP95Pct>=90 or (NetworkCoveragePct>=50 and (P95RTTms>250 or P10BandwidthMbps<5 or TcpFallbackPct>50)),1,CounterCoverage==\"Missing\" and NetworkCoveragePct==0,4,CounterCoverage!=\"CPU + memory\" or CpuSamples<20 or MemorySamples<20 or NetworkCoveragePct<50 or CpuP95Pct>=70 or MemoryUsedP95Pct>=80 or P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20,2,3)\r\n| extend Finding=case(HealthStatus in~ (\"Unhealthy\",\"Unavailable\"),\"AVD agent health failure\",CounterCoverage==\"Missing\",\"Performance telemetry missing\",CounterCoverage!=\"CPU + memory\",\"Required counter missing\",CpuSamples<20 or MemorySamples<20,\"Low performance sample count\",CpuP95Pct>=85 and MemoryUsedP95Pct>=90,\"CPU and memory pressure\",CpuP95Pct>=85,\"CPU pressure\",MemoryUsedP95Pct>=90,\"Memory pressure\",NetworkCoveragePct<50,\"Insufficient network coverage\",P95RTTms>250,\"High AVD round-trip time\",P10BandwidthMbps<5,\"Constrained AVD bandwidth\",TcpFallbackPct>50,\"High TCP fallback\",CpuP95Pct>=70 or MemoryUsedP95Pct>=80,\"Capacity warning\",P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20,\"Network or transport warning\",\"No monitored threshold exceeded\")\r\n| extend NextAction=case(HealthStatus in~ (\"Unhealthy\",\"Unavailable\"),\"Review failed health checks\",CounterCoverage!=\"CPU + memory\" or CpuSamples<20 or MemorySamples<20,\"Repair AMA/DCR counter collection\",CpuP95Pct>=70 or MemoryUsedP95Pct>=80,\"Compare workload and healthy hosts\",NetworkCoveragePct<50,\"Repair network telemetry coverage\",P95RTTms>120 or P10BandwidthMbps<10 or TcpFallbackPct>20,\"Review protocol, gateway, and client panels\",\"Compare with the complaint timeline\")\r\n| project Status,HostPool,SessionHost,Finding,NextAction,HealthStatus,LatestActiveSessions,UsersInRange,CpuP95Pct,MemoryUsedP95Pct,CounterCoverage,TcpFallbackPct,P95RTTms,P10BandwidthMbps,NetworkCoveragePct,StatusSort\r\n| order by StatusSort asc,CpuP95Pct desc\r\n| project-away StatusSort",
        "size": 0,
        "title": "Session-host health, capacity, and path drill-down",
        "description": "One diagnostic row per session host, combining CPU, memory, latest AVD health, active sessions, TCP fallback, RTT, bandwidth, and telemetry confidence. Use only after the host-pool matrix identifies a pool.",
        "noDataMessage": "No session hosts matched. Select a pool with observed connections or widen the time range.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "Status",
              "label": "Status",
              "width": "9ch"
            },
            {
              "columnId": "HostPool",
              "label": "Host pool",
              "width": "1fr"
            },
            {
              "columnId": "SessionHost",
              "label": "Session host",
              "width": "1fr"
            },
            {
              "columnId": "Finding",
              "label": "Primary finding",
              "width": "1.2fr"
            },
            {
              "columnId": "NextAction",
              "label": "Recommended next action",
              "width": "1.5fr"
            },
            {
              "columnId": "HealthStatus",
              "label": "AVD health",
              "width": "10ch"
            },
            {
              "columnId": "LatestActiveSessions",
              "label": "Latest active",
              "width": "9ch"
            },
            {
              "columnId": "UsersInRange",
              "label": "Users in range",
              "width": "9ch"
            },
            {
              "columnId": "CpuP95Pct",
              "label": "CPU P95 %",
              "width": "9ch"
            },
            {
              "columnId": "MemoryUsedP95Pct",
              "label": "Memory P95 %",
              "width": "10ch"
            },
            {
              "columnId": "CounterCoverage",
              "label": "Counters",
              "width": "12ch"
            },
            {
              "columnId": "TcpFallbackPct",
              "label": "TCP fallback %",
              "width": "10ch"
            },
            {
              "columnId": "P95RTTms",
              "label": "RTT P95 ms",
              "width": "9ch"
            },
            {
              "columnId": "P10BandwidthMbps",
              "label": "Bandwidth P10 Mbps",
              "width": "11ch"
            },
            {
              "columnId": "NetworkCoveragePct",
              "label": "Network coverage %",
              "width": "10ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Healthy",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Warning",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "High",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": "",
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "HealthStatus",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Healthy",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unhealthy",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Unavailable",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": "",
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "CpuP95Pct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">=",
                    "thresholdValue": "85",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "70",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "MemoryUsedP95Pct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">=",
                    "thresholdValue": "90",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "CounterCoverage",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "CPU + memory",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Missing",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": "",
                    "representation": "orange",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "TcpFallbackPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "10",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "NetworkCoveragePct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "80",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "Session host performance hotspots",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let HostScope=materialize(WVDConnections\r\n| where TimeGenerated {TimeRange}\r\n| extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),SessionHost=iff(isempty(SessionHostName),\"Unknown\",SessionHostName)\r\n| extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool),HostKey=tolower(tostring(split(SessionHost,\".\")[0]))\r\n| where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}))\r\n| project CorrelationId,TimeGenerated,HostPool,SessionHost,HostKey,User);let HostMap=HostScope | summarize HostPool=any(HostPool) by HostKey;\r\nlet PerfTrend=Perf\r\n| where TimeGenerated {TimeRange}\r\n| extend HostKey=tolower(tostring(split(Computer,\".\")[0])),TimeBucket=bin(TimeGenerated,15m)\r\n| where HostKey in (HostMap | distinct HostKey)\r\n| summarize CpuAvgPct=avgif(CounterValue,CounterName =~ \"% Processor Time\" and InstanceName =~ \"_Total\"),MemoryUsedAvgPct=avgif(CounterValue,CounterName in~ (\"% Committed Bytes In Use\",\"% Used Memory\")) by TimeBucket,HostKey\r\n| join kind=inner HostMap on HostKey\r\n| summarize CpuAvgPct=round(avg(CpuAvgPct),1),MemoryUsedAvgPct=round(avg(MemoryUsedAvgPct),1) by TimeBucket,HostPool;\r\nunion\r\n(PerfTrend | project TimeBucket,Series=strcat(HostPool,\" - CPU %\"),Value=CpuAvgPct),\r\n(PerfTrend | project TimeBucket,Series=strcat(HostPool,\" - memory used %\"),Value=MemoryUsedAvgPct)\r\n| where isnotnull(Value)\r\n| order by TimeBucket asc",
        "size": 0,
        "title": "Host-pool CPU and memory trend",
        "description": "Fifteen-minute average CPU and memory-used percentages by host pool. Missing memory lines usually mean the percentage memory counter is not collected; use the data-collection guidance to add it.",
        "noDataMessage": "No CPU or memory trend matched. Check Perf coverage, the time range, and host-pool filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "timechart"
      },
      "customWidth": "100",
      "name": "Host pool performance timeline",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 2. Complaint and user impact\r\n**Start:** Select the affected users and the narrowest useful time range, then compare them with peers. **Read:** Similar degradation in both cohorts suggests a shared pool, gateway, or path condition; selected users alone suggest a user, endpoint, local network, workload, or session condition. **Next:** Rank individual users, then open **Session correlation details**, choose the matching session, and copy its Correlation ID. AVD evidence narrows scope but does not prove application cause."
      },
      "name": "AVD causality decision guide",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);\r\nlet C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter}))|extend Cohort=iff('All' in ({UserFilter}),\"All users\",iff(User in ({UserFilter}),\"Selected / complaining users\",\"Other users\"))|project CorrelationId,Cohort,User,Transport);\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSamples=count(),AvgRTTms=avg(EstRoundTripTimeInMs),P95RTTms=percentile(EstRoundTripTimeInMs,95),P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nlet E=WVDErrors|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize ErrorEvents=count() by CorrelationId;\r\nC|join kind=leftouter N on CorrelationId|join kind=leftouter E on CorrelationId|extend NetworkSamples=coalesce(NetworkSamples,long(0)),ErrorEvents=coalesce(ErrorEvents,long(0))|summarize Users=dcount(User),Sessions=count(),NetworkSessions=countif(NetworkSamples>0),TcpFallbackSessions=countif(Transport==\"TCP fallback\"),SessionsWithErrors=countif(ErrorEvents>0),AvgRTTms=round(avg(AvgRTTms),1),P95RTTms=round(percentile(P95RTTms,95),1),P10BandwidthMbps=round(percentile(P10BandwidthMbps,10),2) by Cohort|extend NetworkCoveragePct=iff(Sessions==0,real(null),round(100.0*NetworkSessions/Sessions,1)),TcpFallbackPct=iff(Sessions==0,real(null),round(100.0*TcpFallbackSessions/Sessions,1)),SessionsWithErrorsPct=iff(Sessions==0,real(null),round(100.0*SessionsWithErrors/Sessions,1))|project Cohort,Users,Sessions,NetworkCoveragePct,TcpFallbackPct,SessionsWithErrorsPct,AvgRTTms,P95RTTms,P10BandwidthMbps",
        "size": 0,
        "title": "Affected users compared with peers",
        "description": "Step 1: select reported users in the User filter. Compare them with other users in the same host-pool, gateway, and time scope. Similar degradation across both cohorts suggests a shared condition; worse results only for selected users suggest an isolated user, client, local-network, workload, or session condition. If All users is selected, only the baseline row is shown. Continue to Individual user AVD evidence; this comparison narrows scope but does not prove cause.",
        "noDataMessage": "No cohort data matched. Select an affected user, widen the time range, or verify connection and network coverage.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "NetworkCoveragePct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "80",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "TcpFallbackPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "50",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "SessionsWithErrorsPct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "20",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgRTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "10",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ]
        }
      },
      "customWidth": "100",
      "name": "Complaint cohort comparison",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=materialize(WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId);\r\nlet C=materialize(WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0))|extend Transport=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse)==\"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName),SessionHost=iff(isempty(SessionHostName),\"Unknown\",SessionHostName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Transport in ({TransportFilter}))|project CorrelationId,User,HostPool,Gateway,SessionHost,Transport);\r\nlet N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSamples=count(),AvgRTTms=avg(EstRoundTripTimeInMs),P95RTTms=percentile(EstRoundTripTimeInMs,95),AvgBandwidthMbps=avg(EstAvailableBandwidthKBps)*8.0/1000,P10BandwidthMbps=percentile(EstAvailableBandwidthKBps,10)*8.0/1000 by CorrelationId;\r\nlet E=WVDErrors|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize ErrorEvents=count() by CorrelationId;\r\nC|join kind=leftouter N on CorrelationId|join kind=leftouter E on CorrelationId|extend NetworkSamples=coalesce(NetworkSamples,long(0)),ErrorEvents=coalesce(ErrorEvents,long(0))|summarize Sessions=count(),NetworkSessions=countif(NetworkSamples>0),TcpFallbackSessions=countif(Transport==\"TCP fallback\"),ErrorEvents=sum(ErrorEvents),AvgRTTms=round(avg(AvgRTTms),1),P95RTTms=round(max(P95RTTms),1),AvgBandwidthMbps=round(avg(AvgBandwidthMbps),2),P10BandwidthMbps=round(min(P10BandwidthMbps),2),HostPools=make_set(HostPool,5),SessionHosts=make_set(SessionHost,10),Gateways=make_set(Gateway,5) by User|extend NetworkCoveragePct=iff(Sessions==0,real(null),round(100.0*NetworkSessions/Sessions,1)),TcpFallbackPct=iff(Sessions==0,real(null),round(100.0*TcpFallbackSessions/Sessions,1))|extend Status=case(ErrorEvents>5 or TcpFallbackPct>50 or P95RTTms>250 or P10BandwidthMbps<5,\"High\",ErrorEvents>2 or TcpFallbackPct>20 or P95RTTms>120 or P10BandwidthMbps<10,\"Review\",NetworkCoveragePct<50,\"Insufficient data\",\"No measured AVD issue\"),PrimarySignal=case(ErrorEvents>5,\"More than 5 error events\",TcpFallbackPct>50,\"TCP fallback above 50%\",P95RTTms>250,\"P95 RTT above 250 ms\",P10BandwidthMbps<5,\"P10 bandwidth below 5 Mbps\",ErrorEvents>2,\"More than 2 error events\",TcpFallbackPct>20,\"TCP fallback above 20%\",P95RTTms>120,\"P95 RTT above 120 ms\",P10BandwidthMbps<10,\"P10 bandwidth below 10 Mbps\",NetworkCoveragePct<50,\"Network evidence below 50%\",NetworkCoveragePct<80,\"Network evidence below 80%\",\"No configured AVD threshold crossed\"),Evidence=case(NetworkCoveragePct<50,\"Insufficient\",NetworkCoveragePct<80,\"Partial\",\"Good\")|extend StatusSort=case(Status==\"High\",1,Status==\"Review\",2,Status==\"Insufficient data\",3,4)|project Status,PrimarySignal,Evidence,User,Sessions,P95RTTms,P10BandwidthMbps,TcpFallbackPct,ErrorEvents,NetworkCoveragePct,AvgRTTms,AvgBandwidthMbps,HostPools,SessionHosts,Gateways,StatusSort|order by StatusSort asc,P95RTTms desc,Sessions desc",
        "size": 0,
        "title": "Individual user AVD evidence",
        "description": "Step 2: rank users using measured AVD evidence. Read Status, Why, and Evidence quality first. High or Review means at least one threshold crossed; Insufficient data means network evidence is below 50%. No measured AVD issue does not prove the application is healthy. P95 RTT and P10 bandwidth are priority tail metrics. Continue to Session correlation details for the affected user and time.",
        "noDataMessage": "No matching users. Clear user filters, widen the time range, or verify connection collection. Gray means evidence is insufficient or unavailable; it is not a healthy result.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "formatters": [
            {
              "columnMatch": "Status",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "No measured AVD issue",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "Review",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "High",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "NetworkCoveragePct",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "50",
                    "representation": "gray",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "80",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "80",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "TcpFallbackPct",
