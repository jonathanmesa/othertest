      "customWidth": "100",
      "name": "Application user experience triage",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize LinkCount=dcount(LinkId),ClientTransports=make_set(ClientTransportType),ServerTransports=make_set(ServerTransportType),ClientTURNIPs=make_set_if(ClientTURNIP,isnotempty(ClientTURNIP)),ServerTURNIPs=make_set_if(ServerTURNIP,isnotempty(ServerTURNIP)),T=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),S=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),W=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let N=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|summarize NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by CorrelationId;let E=WVDErrors|where TimeGenerated {TimeRange}|summarize ErrorCount=count(),ErrorDetails=make_set(strcat(iff(isempty(CodeSymbolic),tostring(Code),CodeSymbolic),\" | \" ,ActivityType,\" | \" ,Operation,\" | \" ,Source,\" | \" ,Message),10) by CorrelationId;WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|join kind=leftouter N on CorrelationId|join kind=leftouter E on CorrelationId|extend T=coalesce(T,long(0)),S=coalesce(S,long(0)),W=coalesce(W,long(0)),LinkCount=coalesce(LinkCount,long(0)),NetworkSamples=coalesce(NetworkSamples,long(0)),ErrorCount=coalesce(ErrorCount,long(0))|extend Mode=case(TransportType =~ \"TURN\" or T>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or S>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or W>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool),TransportDetail=case(Mode==\"UDP via TURN\",\"Relayed (public network, TURN)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"1\",\"Direct (managed network, private)\",Mode==\"UDP direct\" and tostring(UdpUse)==\"2\",\"Direct (public network, STUN)\",Mode==\"UDP direct\",\"Direct (Shortpath/Multipath link evidence)\",Mode==\"TCP fallback\",\"TCP reverse-connect\",\"Unclassified\"),ObservedEvidence=case(Mode==\"UDP via TURN\",\"TURN transport, TURN IP, or documented UdpUse=4 present\",Mode==\"UDP direct\",\"DIRECT link, Multipath, documented UdpUse=1/2, or MultiLinkAdd evidence present without TURN\",Mode==\"TCP fallback\",\"WebSocket transport present without UDP evidence\",\"No decisive transport evidence\"),Interpretation=case(Mode==\"UDP via TURN\",\"UDP active through relay\",Mode==\"UDP direct\",\"Direct UDP Shortpath active\",Mode==\"TCP fallback\",\"Reverse-connect TCP/TLS 443 used; UDP Shortpath not established or not reported\",\"Do not assume TCP; validate diagnostic coverage\")|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|project CorrelationId,PredecessorConnectionId,TimeGenerated,User=UserName,HostPool,SessionHost=SessionHostName,Gateway,Transport=Mode,TransportDetail,ClientOS,ClientType,ClientVersion,ObservedEvidence,Interpretation,ErrorCount,ErrorDetails,NetworkSamples,AvgRTTms,P95RTTms,AvgBandwidthMbps,P10BandwidthMbps|order by User asc,TimeGenerated desc",
        "size": 0,
        "title": "Session correlation, errors, transport, and network details",
        "description": "Step 3 and canonical escalation handoff. Filter to the affected user and time, choose the session nearest the complaint, then copy Correlation ID. Use it to trace that activity through connection, error, checkpoint, network, transport-link, and optional graphics records. Previous connection ID links an automatic reconnect when Azure reports it. Error details show up to 10 matching entries; use the correlation guide for the complete event sequence.",
        "noDataMessage": "No sessions matched. Clear filters or select a user with a connection in the chosen time range; if still empty, check WVDConnections coverage.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 10000,
          "labelSettings": [
            {
              "columnId": "CorrelationId",
              "label": "Correlation ID",
              "width": "30ch"
            },
            {
              "columnId": "PredecessorConnectionId",
              "label": "Previous connection ID",
              "width": "30ch"
            },
            {
              "columnId": "TransportDetail",
              "label": "Transport detail"
            },
            {
              "columnId": "Interpretation",
              "label": "What this means"
            },
            {
              "columnId": "NetworkSamples",
              "label": "Network samples",
              "width": "10ch"
            },
            {
              "columnId": "AvgRTTms",
              "label": "Avg RTT (ms)",
              "width": "10ch"
            },
            {
              "columnId": "P95RTTms",
              "label": "P95 RTT (ms)",
              "width": "10ch"
            },
            {
              "columnId": "AvgBandwidthMbps",
              "label": "Avg bandwidth (Mbps)",
              "width": "12ch"
            },
            {
              "columnId": "P10BandwidthMbps",
              "label": "P10 bandwidth (Mbps)",
              "width": "12ch"
            },
            {
              "columnId": "ErrorCount",
              "label": "Errors",
              "width": "8ch"
            },
            {
              "columnId": "ErrorDetails",
              "label": "Error details"
            }
          ],
          "formatters": [
            {
              "columnMatch": "Transport",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "==",
                    "thresholdValue": "Unknown",
                    "representation": "gray",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "TCP fallback",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "UDP via TURN",
                    "representation": "blue",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "==",
                    "thresholdValue": "UDP direct",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "{0}{1}"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgRTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95RTTms",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "250",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "120",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgBandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "10",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P10BandwidthMbps",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": "<",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "<",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "10",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "ErrorCount",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "5",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "0",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            }
          ]
        },
        "sortBy": [
          {
            "itemKey": "User",
            "sortOrder": 1
          },
          {
            "itemKey": "TimeGenerated",
            "sortOrder": 2
          }
        ]
      },
      "name": "Session transport evidence",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 1,
      "content": {
        "json": "## 3. Logon, agent health, and graphics\r\n**Start:** Use logon phases for slow sign-in, health checks for unavailable hosts, and graphics for visual lag. **Read:** The colored column identifies the likely layer. **Next:** Route to profile/identity, host platform, network, or endpoint support, then use **Session correlation details** to capture the affected activity ID when session evidence is needed."
      },
      "name": "Host and profile section",
      "styleSettings": {
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let C=WVDConnections|where TimeGenerated {TimeRange}|where State==\"Connected\"|summarize arg_max(TimeGenerated,*) by CorrelationId|extend HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter}));WVDCheckpoints|where TimeGenerated {TimeRange}|where Name==\"LogonDelay\"|join kind=inner (C|project CorrelationId,HostPool,Gateway,User,SessionHostName) on CorrelationId|extend AuthenticationMs=todouble(Parameters.AuthenticateUser),LogonTotalMs=todouble(Parameters.WinLogon_Total),GpoMs=todouble(Parameters.WinLogon_Logon_GPClient),ProfileMs=todouble(Parameters.WinLogon_Logon_Profiles),EventNotificationMs=todouble(Parameters.WinLogon_Logon_Sens),SessionEnvironmentMs=todouble(Parameters.WinLogon_Logon_SessionEnv),TerminalServicesMs=todouble(Parameters.WinLogon_Logon_TermSrv),FsLogixMs=todouble(Parameters.WinLogon_Logon_frxsvc),StartShellMs=todouble(Parameters.WinLogon_StartShell)|summarize Logons=count(),TotalLogonMin=round(sum(LogonTotalMs)/60000.0,2),AvgAuthenticationSec=round(avg(AuthenticationMs)/1000.0,1),P95AuthenticationSec=round(percentile(AuthenticationMs,95)/1000.0,1),AvgLogonTotalMin=round(avg(LogonTotalMs)/60000.0,2),P95LogonTotalMin=round(percentile(LogonTotalMs,95)/60000.0,2),AvgGpoSec=round(avg(GpoMs)/1000.0,1),AvgProfileSec=round(avg(ProfileMs)/1000.0,1),AvgEventNotificationSec=round(avg(EventNotificationMs)/1000.0,1),AvgSessionEnvironmentSec=round(avg(SessionEnvironmentMs)/1000.0,1),AvgTerminalServicesSec=round(avg(TerminalServicesMs)/1000.0,1),AvgFsLogixSec=round(avg(FsLogixMs)/1000.0,1),AvgStartShellSec=round(avg(StartShellMs)/1000.0,1) by HostPool,SessionHostName|order by P95LogonTotalMin desc,Logons desc",
        "size": 0,
        "title": "Logon timing and slow phases",
        "description": "Each row summarizes one session host. Read P95 logon total first, then scan the colored phases to locate authentication, GPO, profile, FSLogix, event notification, session environment, terminal services, or shell delay. Over 10 seconds is warning and over 30 seconds is high. To inspect one user attempt, use Session correlation details and query WVDCheckpoints with its Correlation ID.",
        "noDataMessage": "No LogonDelay checkpoints were found. Enable WVDCheckpoints diagnostic collection and widen the time range if needed.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 1000,
          "labelSettings": [
            {
              "columnId": "HostPool",
              "label": "Host pool"
            },
            {
              "columnId": "SessionHostName",
              "label": "Session host"
            },
            {
              "columnId": "Logons",
              "label": "Logons",
              "width": "8ch"
            },
            {
              "columnId": "TotalLogonMin",
              "label": "Total logon time (min)",
              "width": "14ch"
            },
            {
              "columnId": "AvgAuthenticationSec",
              "label": "Avg authentication (sec)",
              "width": "14ch"
            },
            {
              "columnId": "P95AuthenticationSec",
              "label": "P95 authentication (sec)",
              "width": "14ch"
            },
            {
              "columnId": "AvgLogonTotalMin",
              "label": "Avg logon total (min)",
              "width": "14ch"
            },
            {
              "columnId": "P95LogonTotalMin",
              "label": "P95 logon total (min)",
              "width": "14ch"
            },
            {
              "columnId": "AvgGpoSec",
              "label": "Avg GPO (sec)",
              "width": "10ch"
            },
            {
              "columnId": "AvgProfileSec",
              "label": "Avg profile (sec)",
              "width": "10ch"
            },
            {
              "columnId": "AvgFsLogixSec",
              "label": "Avg FSLogix (sec)",
              "width": "10ch"
            },
            {
              "columnId": "AvgStartShellSec",
              "label": "Avg shell start (sec)",
              "width": "12ch"
            },
            {
              "columnId": "AvgEventNotificationSec",
              "label": "Avg event notification (sec)",
              "width": "14ch"
            },
            {
              "columnId": "AvgSessionEnvironmentSec",
              "label": "Avg session environment (sec)",
              "width": "14ch"
            },
            {
              "columnId": "AvgTerminalServicesSec",
              "label": "Avg terminal services (sec)",
              "width": "14ch"
            }
          ],
          "formatters": [
            {
              "columnMatch": "P95AuthenticationSec",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "60",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "P95LogonTotalMin",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "2",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "1",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgFsLogixSec",
              "formatter": 18,
              "formatOptions": {
                "thresholdsOptions": "colors",
                "thresholdsGrid": [
                  {
                    "operator": ">",
                    "thresholdValue": "30",
                    "representation": "redBright",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">",
                    "thresholdValue": "10",
                    "representation": "orange",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": ">=",
                    "thresholdValue": "0",
                    "representation": "green",
                    "text": "{0}{1}"
                  },
                  {
                    "operator": "Default",
                    "thresholdValue": null,
                    "representation": "gray",
                    "text": "No data"
                  }
                ]
              }
            },
            {
              "columnMatch": "AvgGpoSec",
              "formatter": 18,
              "formatOptions": {
