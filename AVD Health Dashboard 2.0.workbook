    {
      "type": 3,
      "content": {
        "version": "KqlItem/1.0",
        "query": "let L=WVDMultiLinkAdd|where TimeGenerated {TimeRange}|summarize HasTurn=countif(ClientTransportType =~ \"TURN\" or ServerTransportType =~ \"TURN\" or isnotempty(ClientTURNIP) or isnotempty(ServerTURNIP)),HasShort=countif(ClientTransportType in~ (\"Shortpath\",\"DIRECT\") or ServerTransportType in~ (\"Shortpath\",\"DIRECT\")),HasWeb=countif(ClientTransportType =~ \"WEBSOCKET\" or ServerTransportType =~ \"WEBSOCKET\") by CorrelationId;let C=materialize(WVDConnections|where TimeGenerated {TimeRange}|summarize ConnectedAt=minif(TimeGenerated,State==\"Connected\"),DisconnectedAt=minif(TimeGenerated,State in~ (\"Disconnected\",\"Completed\",\"Canceled\",\"Cancelled\",\"Failed\",\"SessionEnded\")),arg_max(TimeGenerated,*) by CorrelationId|join kind=leftouter L on CorrelationId|extend HasTurn=coalesce(HasTurn,long(0)),HasShort=coalesce(HasShort,long(0)),HasWeb=coalesce(HasWeb,long(0))|extend Mode=case(TransportType =~ \"TURN\" or HasTurn>0 or tostring(UdpUse) == \"4\",\"UDP via TURN\",TransportType in~ (\"Shortpath\",\"Multipath\") or tostring(UdpUse) in (\"1\",\"2\") or HasShort>0,\"UDP direct\",TransportType in~ (\"Websocket\",\"TCP Websocket\") or HasWeb>0,\"TCP fallback\",\"Unknown\"),HostPool=extract(\"/hostpools/([^/]+)\",1,_ResourceId),Gateway=iff(isempty(GatewayRegion),\"Unknown\",GatewayRegion),User=iff(isempty(UserName),\"Unknown\",UserName)|extend HostPool=iff(isempty(HostPool),\"Unknown\",HostPool)|where ('All' in ({HostPoolFilter}) or HostPool in ({HostPoolFilter})) and ('All' in ({GatewayFilter}) or Gateway in ({GatewayFilter})) and ('All' in ({UserFilter}) or User in ({UserFilter})) and ('All' in ({TransportFilter}) or Mode in ({TransportFilter}))|extend DurationMinutes=iff(isnotempty(ConnectedAt) and isnotempty(DisconnectedAt),datetime_diff('minute',DisconnectedAt,ConnectedAt),long(null))|project CorrelationId,Mode,DurationMinutes);let DurationStats=C|summarize Sessions=count(),DisconnectedSessions=countif(isnotempty(DurationMinutes)),AvgConnectedHours=round(avg(DurationMinutes)/60.0,2),MedianConnectedHours=round(percentile(DurationMinutes,50)/60.0,2),P95ConnectedHours=round(percentile(DurationMinutes,95)/60.0,2) by Mode;let NetworkStats=WVDConnectionNetworkData|where TimeGenerated {TimeRange}|join kind=inner C on CorrelationId|summarize NetworkSessions=dcount(CorrelationId),NetworkSamples=count(),AvgRTTms=round(avg(EstRoundTripTimeInMs),1),P95RTTms=round(percentile(EstRoundTripTimeInMs,95),1),AvgBandwidthMbps=round(avg(EstAvailableBandwidthKBps)*8.0/1000,2),P10BandwidthMbps=round(percentile(EstAvailableBandwidthKBps,10)*8.0/1000,2) by Mode;DurationStats|join kind=leftouter NetworkStats on Mode|extend NetworkSessions=coalesce(NetworkSessions,long(0))|extend NetworkCoverage_Pct=iff(Sessions==0,real(null),round(100.0*NetworkSessions/Sessions,1))|project Protocol=Mode,Sessions,DisconnectedSessions,AvgConnectedHours,MedianConnectedHours,P95ConnectedHours,NetworkCoverage_Pct,AvgRTTms,P95RTTms,AvgBandwidthMbps,P10BandwidthMbps|order by AvgConnectedHours desc",
        "size": 0,
        "title": "Protocol comparison: which is faster and more stable",
        "description": "Compare the four transport rows. Better outcome: longer connected time, lower RTT, and higher bandwidth. TCP fallback is supported AVD reverse-connect over TCP/TLS 443 when UDP Shortpath was not established or reported. It needs attention only when its share rises or its session duration, RTT, or bandwidth is worse than UDP. Ignore network conclusions when coverage is low.",
        "noDataMessage": "No connected session duration or network data was found for the selected filters.",
        "showAnalytics": true,
        "showRefreshButton": true,
        "showExportToExcel": true,
        "exportToExcelOptions": "visible",
        "timeContextFromParameter": "TimeRange",
        "queryType": 0,
        "resourceType": "microsoft.operationalinsights/workspaces",
        "crossComponentResources": [
          "{Workspace}"
        ],
        "visualization": "table",
        "gridSettings": {
          "rowLimit": 100,
          "labelSettings": [
            {
              "columnId": "Protocol",
